rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCeoEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == "ceo@gmail.com";
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isCeo() {
      return isSignedIn() && (request.auth.token.ceo == true || isCeoEmail());
    }

    function isStaff() {
      return isSignedIn() && (
        request.auth.token.staff == true
        || (request.auth.token.email != null && request.auth.token.email.matches('^staff\\+'))
        || request.auth.uid.matches('^staff_')
      );
    }

    function staffVenueMatches(venueId) {
      return isStaff() && (
        (request.auth.token.venue != null && request.auth.token.venue == venueId)
        || request.auth.uid.matches('^staff_' + venueId + '$')
      );
    }

    function hasPrivilegedRole() {
      return isAdmin() || isCeo() || isStaff();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function ceoVoucherExists(code) {
      return exists(/databases/$(database)/documents/ceoVouchers/$(code));
    }

    function immutableRedemptionFieldsUnchanged() {
      return request.resource.data.code == resource.data.code
        && request.resource.data.passId == resource.data.passId
        && request.resource.data.perk == resource.data.perk
        && request.resource.data.perkKey == resource.data.perkKey
        && request.resource.data.member == resource.data.member
        && request.resource.data.ceo == resource.data.ceo;
    }

    function isPendingStatus(status) {
      return status == "pending" || status == "requested";
    }

    function isAppOpen() {
      return get(/databases/$(database)/documents/settings/app).data.appLocked != true;
    }

    function isAppLocked() {
      return get(/databases/$(database)/documents/settings/app).data.appLocked == true;
    }

    function canAccessApp() {
      return isAppOpen() || isCeo() || isAdmin();
    }

    function canWriteApp() {
      return !isAppLocked() || isAdmin() || isCeo();
    }

    function ownerMemberCreateAllowed() {
      return !request.resource.data.keys().hasAny([
        "ceo",
        "admin",
        "staff",
        "revoked",
        "paused",
        "pausedAt",
        "resumedAt",
        "freeMembership",
        "membershipOverride",
        "membership_override",
        "membershipTierOverride",
        "override",
        "tier",
        "membershipTier",
        "uid",
        "passCode",
        "passId",
        "email",
        "emailLower",
        "emailVerified",
        "role",
        "venueId",
        "venueName",
        "excludeFromLeaderboards",
        "validUntil",
        "paymentStatus",
        "membershipStatus",
        "billing",
        "billingProvider",
        "stripeCustomerId",
        "stripeSubscriptionId",
        "defaultPaymentMethodId",
        "cancelAtPeriodEnd",
        "cancelRequestedAt",
        "canceledAt",
        "currentPeriodEnd",
        "nextRenewal",
        "lastCharge",
        "lastChargeAt",
        "lastPaidAt",
        "lastPaymentAt",
        "lastStripeEvent",
        "lastStripeEventAt",
        "lastInvoiceId",
        "lastInvoiceStatus",
        "lastInvoicePaid",
        "extraRedemptionTokens",
        "extraVouchers",
        "lastVoucherPurchase",
        "points",
        "pointsDaily",
        "pointsDailyDate",
        "pointsUpdatedAt",
        "pointsMonthlyTokenGrants",
        "pointsRedeemedTotal",
        "lastPointsRedemptionAt",
        "lastPointsRedemptionType",
        "venuesVisited",
        "ceoMonthlyTokenGrants",
        "perksRemaining"
      ]);
    }

    function ownerMemberUpdateAllowed() {
      return !request.resource.data.diff(resource.data).changedKeys().hasAny([
        "ceo",
        "admin",
        "staff",
        "revoked",
        "paused",
        "pausedAt",
        "resumedAt",
        "freeMembership",
        "membershipOverride",
        "membership_override",
        "membershipTierOverride",
        "override",
        "tier",
        "membershipTier",
        "uid",
        "passCode",
        "passId",
        "email",
        "emailLower",
        "emailVerified",
        "role",
        "venueId",
        "venueName",
        "excludeFromLeaderboards",
        "validUntil",
        "paymentStatus",
        "membershipStatus",
        "billing",
        "billingProvider",
        "stripeCustomerId",
        "stripeSubscriptionId",
        "defaultPaymentMethodId",
        "cancelAtPeriodEnd",
        "cancelRequestedAt",
        "canceledAt",
        "currentPeriodEnd",
        "nextRenewal",
        "lastCharge",
        "lastChargeAt",
        "lastPaidAt",
        "lastPaymentAt",
        "lastStripeEvent",
        "lastStripeEventAt",
        "lastInvoiceId",
        "lastInvoiceStatus",
        "lastInvoicePaid",
        "extraRedemptionTokens",
        "extraVouchers",
        "lastVoucherPurchase",
        "points",
        "pointsDaily",
        "pointsDailyDate",
        "pointsUpdatedAt",
        "pointsMonthlyTokenGrants",
        "pointsRedeemedTotal",
        "lastPointsRedemptionAt",
        "lastPointsRedemptionType",
        "venuesVisited",
        "ceoMonthlyTokenGrants",
        "perksRemaining"
      ]);
    }

    // CEO-issued vouchers: only server (Admin SDK / Cloud Functions) may create/modify.
    // Clients may read these only if they are authorized staff/CEO/admin (custom claims).
    match /ceoVouchers/{code} {
      allow read: if hasPrivilegedRole() && canAccessApp();
      allow create, update, delete: if false;
    }

    // Pass index (passCode -> uid). Public-ish read for signed-in users.
    match /passes/{passCode} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.uid || hasPrivilegedRole());
      allow create, update, delete: if false;
    }

    // Public runtime config for global feature/control toggles.
    // Readable by all clients; writable only via Cloud Functions (Admin SDK).
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Global gate config (waitlist mode, launch messaging). Public read, server-only write.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Public waitlist entries are separate from auth/users.
    match /waitlist/{entryId} {
      allow create: if request.resource.data.keys().hasOnly([
          "firstName",
          "lastName",
          "email",
          "createdAt",
          "source",
          "status",
          "consent",
          "ipHash",
          "userAgent"
        ])
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.email is string
        && request.resource.data.email.size() > 4
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$')
        && request.resource.data.consent == true
        && request.resource.data.status == "active"
        && request.resource.data.source is string;
      allow read: if isAdmin() || isCeo();
      allow update, delete: if false;
    }

    // Public waitlist total count (updated via Cloud Functions only).
    match /counters/{docId} {
      allow read: if docId == "waitlist";
      allow write: if false;
    }

    // Waitlist blast jobs (CEO/admin + server only).
    match /mailQueue/{jobId} {
      allow read: if isAdmin() || isCeo();
      allow write: if false;
    }

    // Voucher redemptions (codes)
    match /redemptions/{code} {
      // Global redemption ledger is staff/CEO/admin only.
      allow read: if isSignedIn() && hasPrivilegedRole() && canAccessApp();

      // Allow clients to create redemptions, but prevent client-created CEO redemptions.
      // CEO redemptions are allowed only if the code exists in ceoVouchers.
      // Non-privileged callers may only create pending/requested entries.
      allow create: if isSignedIn()
        && canAccessApp()
        && request.resource.data.code == code
        && !(request.resource.data.ceo == true && !ceoVoucherExists(code))
        && (isPendingStatus(request.resource.data.status) || hasPrivilegedRole());

      // Allow updates for authenticated callers, but disallow setting `ceo: true` unless caller has proper claim.
      // Allow status/venue/verifiedAt updates while locking immutable fields.
      allow update: if isSignedIn()
        && canAccessApp()
        && immutableRedemptionFieldsUnchanged()
        && !(resource.data.ceo == true && !ceoVoucherExists(code))
        && (
          hasPrivilegedRole()
          || (
            isPendingStatus(resource.data.status)
            && isPendingStatus(request.resource.data.status)
            && request.resource.data.verifiedAt == resource.data.verifiedAt
            && request.resource.data.used == resource.data.used
          )
        );

      // No client delete
      allow delete: if false;
    }

    // Venues collection with subcollections
    match /venues/{venueId} {
      allow read: if true;
      // Top-level venue admin fields are server-controlled via callable functions only.
      allow create, update, delete: if false;

      match /perks/{perkId} {
        allow read: if true;
        // Staff mutations are handled by callable Cloud Functions (server-side enforcement).
        allow create, update, delete: if isSignedIn() && (isAdmin() || isCeo());
      }

      match /redemptions/{redemptionId} {
        allow read: if isSignedIn() && (
          isAdmin() || isCeo() || staffVenueMatches(venueId)
        );
        allow create, update: if isSignedIn() && canWriteApp() && (
          isAdmin() || isCeo()
          || (
            staffVenueMatches(venueId)
            && (
              request.resource.data.venueId == venueId
              || resource.data.venueId == venueId
            )
          )
        );
        allow delete: if false;
      }

      match /staffMembers/{staffId} {
        allow read: if isSignedIn() && (isAdmin() || isCeo() || staffVenueMatches(venueId));
        allow create, update: if isSignedIn() && canWriteApp() && (isAdmin() || isCeo());
        allow delete: if false;
      }

      match /activityLog/{logId} {
        allow read: if isSignedIn() && (isAdmin() || isCeo() || staffVenueMatches(venueId));
        allow create: if isSignedIn() && canWriteApp() && (isAdmin() || isCeo());
        allow update, delete: if false;
      }

      match /shiftCloseouts/{shiftKey} {
        allow read: if isSignedIn() && (isAdmin() || isCeo() || staffVenueMatches(venueId));
        // Staff writes flow through callable functions only.
        allow create, update: if isSignedIn() && canWriteApp() && (isAdmin() || isCeo());
        allow delete: if isAdmin() || isCeo();
      }

      match /shiftState/{docId} {
        // Expose current venue open/closed state to members for realtime "Open now".
        allow read: if true;
        allow create, update: if isSignedIn() && canWriteApp() && (isAdmin() || isCeo());
        allow delete: if isAdmin() || isCeo();
      }

      match /shiftSessions/{shiftKey} {
        allow read: if isSignedIn() && (isAdmin() || isCeo() || staffVenueMatches(venueId));
        allow create, update: if isSignedIn() && canWriteApp() && (isAdmin() || isCeo());
        allow delete: if isAdmin() || isCeo();
      }
    }

    // Allow read access for any perks collection (collectionGroup("perks") listeners).
    match /{path=**}/perks/{perkId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Tonight's alerts (staff posts, everyone reads)
    match /alerts/{id} {
      allow read: if true;
      // Staff writes flow through callable functions only.
      allow create, update, delete: if isSignedIn() && canWriteApp() && (isAdmin() || isCeo());
    }

    // Shared deals (staff posts, everyone reads)
    match /deals/{id} {
      allow read: if true;
      // Staff writes flow through callable functions only.
      allow create, update, delete: if isSignedIn() && canWriteApp() && (isAdmin() || isCeo());
    }

    // VIP-only deals (staff posts, everyone reads)
    match /vipDeals/{id} {
      allow read: if true;
      // Staff writes flow through callable functions only.
      allow create, update, delete: if isSignedIn() && canWriteApp() && (isAdmin() || isCeo());
    }

    // Venue-defined monthly perks (staff writes only for their venue; everyone reads)
    match /venuePerks/{venueId} {
      allow read: if true;
      // Staff writes flow through callable functions only.
      allow create, update: if isSignedIn() && canWriteApp() && (isAdmin() || isCeo());
      allow delete: if (isAdmin() || isCeo()) && canWriteApp();
    }

    // Member profiles (readable to authenticated users; writes limited)
    match /members/{uid} {
      allow read: if isSignedIn() && (isOwner(uid) || isAdmin() || isCeo());
      allow create: if isSignedIn() && isOwner(uid) && ownerMemberCreateAllowed();
      allow update: if isSignedIn() && (
        (isAdmin() || isCeo())
        || (isOwner(uid) && !isAppLocked() && ownerMemberUpdateAllowed())
      );
      allow delete: if isOwner(uid) || isAdmin() || isCeo();
    }

    match /members/{uid}/redemptions/{redemptionId} {
      allow read: if isSignedIn() && (isOwner(uid) || isAdmin() || isCeo());
      allow create, update, delete: if false;
    }

    match /members/{uid}/pointsRedemptions/{redemptionId} {
      allow read: if isSignedIn() && (isOwner(uid) || isAdmin() || isCeo());
      allow create, update, delete: if false;
    }

    match /members/{uid}/alertCheckins/{checkinId} {
      allow read: if isSignedIn() && (isOwner(uid) || isAdmin() || isCeo());
      allow create, update, delete: if false;
    }

    // Allow CEO/admin to read any redemptions subcollection (collectionGroup).
    match /{path=**}/redemptions/{redemptionId} {
      allow read: if isCeo() || isAdmin();
      allow create, update, delete: if false;
    }

    // Username directory for login-by-username
    match /usernames/{name} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.uid || isAdmin() || isCeo());
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/usernames/$(name))
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || isCeo();
    }

    // CEO free memberships — lookup by passCode, readable by authed users, writeable only by privileged roles
    match /freeMemberships/{passCode} {
      allow read: if isSignedIn();
      allow create, update, delete: if (isAdmin() || isCeo()) && canWriteApp();
    }

    // Staff → CEO direct messages (per-venue)
    match /staffMessages/{id} {
      // Staff can read only their venue messages; CEO/admin can read all.
      allow read: if isSignedIn() && (
        isAdmin() ||
        isCeo() ||
        (isStaff() && (
          request.auth.uid == resource.data.staffUid ||
          staffVenueMatches(resource.data.venueId)
        ))
      );

      // Staff can create for their own venue; CEO/admin can initiate venue threads.
      allow create: if isSignedIn()
        && !isAppLocked()
        && request.resource.data.message is string
        && request.resource.data.venueId is string
        && (
          (
            isStaff()
            && request.resource.data.staffUid == request.auth.uid
            && staffVenueMatches(request.resource.data.venueId)
          )
          ||
          (
            isAdmin() || isCeo()
          )
        );

      // CEO/admin can update (reply/read flags + deletes), staff can mark read or hide their copy.
      allow update: if isSignedIn()
        && canWriteApp()
        && (
          (isAdmin() || isCeo())
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(["reply", "repliedAt", "readByCeo", "readByStaff", "deletedByCeo"])
        ||
          (isStaff()
            && !isAppLocked()
            && (request.auth.uid == resource.data.staffUid
              || staffVenueMatches(resource.data.venueId))
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(["readByStaff", "readByStaffAt", "deletedByStaff"]))
        )
        && request.resource.data.venueId == resource.data.venueId
        && request.resource.data.staffUid == resource.data.staffUid;

      allow delete: if false;
    }

    // CEO → member notices/messages
    match /memberMessages/{id} {
      // CEO/admin can read all. Members can read only their own messages.
      allow read: if isSignedIn() && (
        isAdmin()
        || isCeo()
        || (request.auth.uid == resource.data.uid)
      );

      // Only CEO/admin can create outbound member messages.
      allow create: if isSignedIn()
        && canWriteApp()
        && (isAdmin() || isCeo())
        && request.resource.data.uid is string
        && request.resource.data.message is string;

      // Members may only mark their own message as read.
      // CEO/admin may update any message.
      allow update: if isSignedIn() && (
        (
          isAdmin() || isCeo()
        )
        || (
          request.auth.uid == resource.data.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["read", "readAt"])
        )
      );

      allow delete: if isAdmin() || isCeo();
    }

    // Venue ratings
    match /venueRatings/{venueId} {
      allow read: if true;
      allow write: if isSignedIn() && !isAppLocked();
    }

    // Reviews (any signed-in user can create/read; no deletes)
    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn() && !isAppLocked();
      allow update, delete: if false;
    }

    // Close-out reports stored per venue (optional; allow only authed writes, public reads)
    match /closeOutReports/{id} {
      allow read: if hasPrivilegedRole();
      // Staff writes flow through callable functions only.
      allow write: if (isAdmin() || isCeo()) && canWriteApp();
      allow delete: if isAdmin() || isCeo();
    }

    // App settings (e.g., launch mode). Readable by all; writable only by privileged roles.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isCeo();
    }

    match /systemEmails/{id} {
      allow read: if isAdmin() || isCeo();
      allow write: if isAdmin() || isCeo();
    }

    match /mail/{id} {
      allow read: if false;
      allow write: if isAdmin() || isCeo();
      allow delete: if false;
    }
  }
}
